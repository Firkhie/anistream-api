# ==============================================================================
# AniStream API Environment Configuration (.env.sample)
# ==============================================================================

# Server Port & Mode
PORT=3000
NODE_ENV=development

# Allowed CORS Origins (comma-separated origins, or "*" for public access)
# In production, set to your frontend domain: e.g. https://your-frontend.vercel.app
ALLOWED_ORIGINS=*

# Optional Shared Secret Key for Backend-to-Backend calls
# Allows automated scrapers/services with header "x-api-key: <key>" to bypass bot blocker in production
API_SECRET_KEY=

# ==============================================================================
# Upstash Redis Configuration (Distributed Cache & Global Rate Limiting)
# ==============================================================================
# Obtain credentials from https://console.upstash.com/
# If left empty, API falls back seamlessly to in-memory rate limiting with cache bypass (fail-open)
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token